# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: use PostgreSQL instead of the local SQLite file.
# DATABASE_URL=postgres://user:password@localhost:5432/me_nd_you
# Optional: move the Django admin to a hard-to-guess path in production.
# ADMIN_URL=admin/
# Email. With DEBUG=True, leaving EMAIL_PROVIDER unset prints mail locally.
# In production, leaving it unset safely disables account email delivery.
# When ready, choose brevo, resend or postmark (HTTPS API, no SMTP).
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# DEFAULT_FROM_EMAIL=hello@your-domain.example

# Shown on the privacy policy and terms pages for privacy requests.
# PRIVACY_CONTACT_EMAIL=privacy@your-domain.example
# Chat messages are encrypted with this key. Make your own local key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and paste it here. Never reuse your production key locally, and never
# commit it. Losing the key makes the messages it encrypted unreadable.
CHAT_ENCRYPTION_KEYS=
