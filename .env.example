# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional: use PostgreSQL instead of the local SQLite file.
# DATABASE_URL=postgres://user:password@localhost:5432/me_nd_you
# Optional: move the Django admin to a hard-to-guess path in production.
# ADMIN_URL=admin/
# Email. Leave EMAIL_PROVIDER unset locally: mail is printed to the console.
# In production set it to brevo, resend or postmark (HTTPS API, no SMTP).
# EMAIL_PROVIDER=
# EMAIL_API_KEY=
# DEFAULT_FROM_EMAIL=hello@your-domain.example
